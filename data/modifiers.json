{
  "_readme": [
    "Per-language seed modifiers and stopwords. Edit this file to tune coverage;",
    "no Python change is needed. Always save as UTF-8.",
    "",
    "alphabet  - word-INITIAL letters only, since a letter seed means 'the next",
    "            word starts with this'. German therefore adds ae/oe/ue but never",
    "            eszett, which no German word begins with.",
    "stopwords - casefolded. Used to keep cluster labels readable. The modifier",
    "            terms below are unioned in automatically, so do not repeat them.",
    "pos       - prefix | suffix | both. Question words go BEFORE the seed in all",
    "            six languages; putting them after produces dead grammar."
  ],

  "en": {
    "alphabet": "abcdefghijklmnopqrstuvwxyz",
    "stopwords": ["a", "an", "the", "and", "or", "but", "if", "of", "to", "in", "on", "at", "by", "as", "is", "are", "was", "were", "be", "been", "am", "do", "does", "did", "have", "has", "had", "it", "its", "this", "that", "these", "those", "there", "here", "i", "you", "he", "she", "we", "they", "my", "your", "his", "her", "our", "their", "not", "no", "so", "than", "then", "too", "very", "just", "up", "out", "off", "into", "some", "any", "all", "more", "most", "s", "t", "re", "ve", "ll", "d", "m"],
