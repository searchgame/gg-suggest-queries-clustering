      "comparatives": {"pos": "suffix", "terms": ["vs", "versus", "or", "alternative to", "better than", "instead of", "compared to"]},
      "commercial": {"pos": "suffix", "terms": ["price", "cost", "cheap", "best", "review", "reviews", "buy", "free", "discount", "near me"]}
